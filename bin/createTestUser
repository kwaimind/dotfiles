#!/bin/bash

# Create test user by scraping fejk.se and calling the GQL API

set -e

if [ -z "$1" ]; then
  echo "Usage: createTestUser <api_url>" >&2
  exit 1
fi

API_URL="$1"

# Fetch and parse fejk.se
html=$(curl -s "https://fejk.se/")

# Extract name (format: "Firstname Lastname")
name=$(echo "$html" | grep -A1 "<strong>Namn:</strong>" | tail -1 | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
firstName=$(echo "$name" | awk '{print $1}')
lastName=$(echo "$name" | awk '{print $2}')

# Extract personnummer (format: YYMMDD-XXXX -> YYYYMMDDXXXX)
pnr=$(echo "$html" | grep -oE '[0-9]{6}-[0-9]{4}' | head -1)
# Convert to 12-digit format (assume 1900s for 00-24, 1900s for rest)
year_prefix=$(echo "$pnr" | cut -c1-2)
if [ "$year_prefix" -le 24 ]; then
  century="20"
else
  century="19"
fi
nationalIdentity="${century}$(echo "$pnr" | tr -d '-')"

# Generate random phone number
phoneNumber="+4670$(jot -r 1 1000000 9999999)"

# Generate email
email="daniel.reed+${nationalIdentity}@mindler.se"

# Build GraphQL request
query='mutation CreateUser($whereUser: CreateUserInput!) { createUser(whereUser: $whereUser) { userId } }'

variables=$(cat <<EOF
{
  "whereUser": {
    "firstName": "$firstName",
    "lastName": "$lastName",
    "nationalIdentity": "$nationalIdentity",
    "phoneNumber": "$phoneNumber",
    "email": "$email",
    "country": "SE",
    "roles": ["Patient"],
    "language": "en"
  }
}
EOF
)

payload=$(jq -n --arg q "$query" --argjson v "$variables" '{query: $q, variables: $v}')

# Call API
response=$(curl -s -X POST "$API_URL" \
  -H "Content-Type: application/json" \
  -d "$payload")

# Extract and print userId
userId=$(echo "$response" | jq -r '.data.createUser.userId // empty')

if [ -n "$userId" ]; then
  echo "Created user: $firstName $lastName ($nationalIdentity)"
  echo "userId: $userId"
else
  echo "Error creating user:"
  echo "$response" | jq .
  exit 1
fi
